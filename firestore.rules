rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isLawyer() {
      return isAuthenticated() && getUserRole() == 'lawyer';
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    // ============ USERS ============

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['client', 'lawyer'] &&
        request.resource.data.is_premium == false;
      allow update: if isAuthenticated() &&
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'account_type',
            'is_active',
            'is_premium',
            'follower_count',
            'following_count',
            'post_count',
            'created_at'
          ])
        );
      allow delete: if isAdmin();
    }

    // ============ LAWYER PROFILES ============

    match /lawyer_profiles/{profileId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(profileId) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.verification_status == 'unverified' &&
        request.resource.data.subscription_tier == 'free';
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============ SPECIALIZATIONS ============

    match /specializations/{specId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }

    // ============ HANDLES ============

    match /handles/{handle} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid &&
        !exists(/databases/$(database)/documents/handles/$(handle));
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.user_id;
    }

    // ============ POSTS ============

    match /posts/{postId} {
      allow read: if true; // Public feed
      allow create: if false;
      allow update: if isAuthenticated() &&
        (
          (
            request.auth.uid == resource.data.author_id &&
            onlyChanged(['is_pinned', 'updated_at'])
          )
        );
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.author_id;
    }

    match /moderation_actions/{actionId} {
      allow read, write: if false;
    }

    // ============ POST LIKES ============

    match /post_likes/{likeId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
    }

    // ============ POST COMMENTS ============

    match /post_comments/{commentId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ============ POST SHARES ============

    match /post_shares/{shareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;
    }

    // ============ POST BOOKMARKS ============

    match /post_bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() &&
        request.auth.uid == resource.data.user_id;
      allow create, delete: if false;
    }

    // ============ FOLLOWS ============

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
    }

    // ============ CONVERSATIONS ============

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2 &&
        request.resource.data.participants.size() <= 10;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.sender_id == request.auth.uid;
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }

    // ============ MESSAGES ============

    match /messages/{messageId} {
      allow read, create, update, delete: if false;
    }

    // ============ CONSULTATIONS ============

    match /consultations/{consultationId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.lawyer_id ||
         request.auth.uid == resource.data.client_id ||
         isAdmin());
      allow create, update: if false;
    }

    // ============ LAWYER AVAILABILITY ============

    match /lawyer_availability/{availId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        request.resource.data.lawyer_id == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.lawyer_id == request.auth.uid;
    }

    // ============ REVIEWS ============

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if false;
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.lawyer_id &&
        onlyChanged(['lawyer_response']);
      allow delete: if isAdmin();
    }

    // ============ SUBSCRIPTION PLANS ============

    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ SUBSCRIPTIONS ============

    match /subscriptions/{subId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.lawyer_id || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
    }

    // ============ VERIFICATION REQUESTS ============

    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.lawyer_id || isAdmin());
      allow create: if isAuthenticated() && isLawyer();
      allow update: if false;
    }

    // ============ NOTIFICATIONS ============

    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        request.auth.uid == resource.data.user_id;
      allow create: if isAuthenticated() &&
        request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.user_id &&
        onlyChanged(['is_read']);
    }

    // ============ CORPORATE ============

    match /corporate_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /corporate_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ HASHTAG COUNTS ============

    match /hashtag_counts/{tag} {
      allow read: if true;
      allow write: if false;
    }

    // ============ POLL VOTES ============

    match /poll_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.user_id;
    }
  }
}
